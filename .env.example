# Copy to .env for local development. Never commit real values.
NODE_ENV=development
# Supabase → Connect → Transaction pooler (port 6543), with your DB password
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# Optional: Supabase root CA (PEM) to fully verify the DB certificate
DATABASE_SSL_CA=
# 48+ random characters:  openssl rand -base64 48
JWT_SECRET=
# Browser origins allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:3000
