# Copy to .env for local development. Never commit real values.
NODE_ENV=development
# Prisma Postgres (Prisma Console → your NASOI database → Connect) – pooled URL
DATABASE_URL=postgres://USER:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=require
# Optional: direct (non-pooled) URL used only for migrations
DIRECT_DATABASE_URL=
# verify (default) | require | disable (local Postgres without TLS)
DATABASE_SSL=verify
# 48+ random characters:  openssl rand -base64 48
JWT_SECRET=
# 32 random bytes: openssl rand -base64 32  (KEEP A BACKUP)
DATA_ENCRYPTION_KEY=
# Browser origins allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:3000
# true = create the demo accounts on deploy (DEO126, VR101, ADMIN)
SEED_DEMO_USERS=false
# E-mail (Nodemailer SMTP) – needed for "Forgot password"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=NASOI <no-reply@yourdomain.com>
APP_URL=http://localhost:3000
