// NASOI database schema (Prisma 7). Tables are created/updated automatically
// on every deploy with `prisma migrate deploy` — no manual SQL needed.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  runtime             = "nodejs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  deo
  verifier
  admin
}

enum UserStatus {
  active
  blocked
}

/// Every portal account: Data Entry Operator, Verifier or Super Admin.
model User {
  id                String     @id // DEO126, VR101, ADMIN …
  role              Role
  name              String
  mobile            String?    @unique @db.VarChar(10)
  email             String?    @unique // stored lower-case
  passwordHash      String     @map("password_hash") // bcrypt, never plain text
  status            UserStatus @default(active)
  failedLoginCount  Int        @default(0) @map("failed_login_count")
  lockedUntil       DateTime?  @map("locked_until") @db.Timestamptz(6)
  lastLoginAt       DateTime?  @map("last_login_at") @db.Timestamptz(6)
  passwordChangedAt DateTime?  @map("password_changed_at") @db.Timestamptz(6)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions  AuthSession[]
  auditLogs AuditLog[]
  profile   Profile?
  documents Document[]

  assignments         Assignment[]   @relation("DeoAssignments")
  assignmentsCreated  Assignment[]   @relation("AdminAssignments")
  notifications       Notification[]
  entries             Entry[]        @relation("DeoEntries")
  entriesVerified     Entry[]        @relation("VerifiedEntries")
  entriesToVerify     Entry[]        @relation("AssignedEntries")
  verifications       Verification[]

  @@map("users")
}

/// One login on one browser. Only the SHA-256 of the refresh secret is stored.
model AuthSession {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id")
  role          Role
  tokenHash     String    @map("token_hash")
  prevTokenHash String?   @map("prev_token_hash") // previous hash, to detect replay
  rotatedAt     DateTime? @map("rotated_at") @db.Timestamptz(6)
  ip            String?
  userAgent     String?   @map("user_agent")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt    DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(6)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokeReason  String?   @map("revoke_reason")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

/// Append-only security log (never stores passwords or tokens).
model AuditLog {
  id        BigInt   @id @default(autoincrement())
  userId    String?  @map("user_id")
  action    String
  ip        String?
  userAgent String?  @map("user_agent")
  meta      Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@map("audit_logs")
}

enum DocumentKind {
  aadhaar // older registrations: front and back in one file
  aadhaar_front
  aadhaar_back
  pan
  bank_proof
  photo
  signature
}

/// Registration details of a DEO / Verifier. Aadhaar and bank account numbers
/// are stored AES-256-GCM encrypted; only the last 4 digits are kept in clear.
model Profile {
  userId        String   @id @map("user_id")
  fatherName    String   @map("father_name")
  motherName    String   @map("mother_name")
  dob           DateTime @db.Date
  gender        String
  category      String
  religion      String
  altMobile     String?  @map("alt_mobile") @db.VarChar(10)
  country       String
  state         String
  district      String
  subDistrict   String   @map("sub_district")
  postOffice    String   @map("post_office")
  pincode       String   @db.VarChar(6)
  policeStation String   @map("police_station")
  address       String
  qualification String
  aadhaarLast4  String   @map("aadhaar_last4") @db.VarChar(4)
  aadhaarHash   String   @unique @map("aadhaar_hash") // HMAC-SHA256, for duplicate check
  aadhaarEnc    String   @map("aadhaar_enc")
  pan           String?  @db.VarChar(10)
  bankName      String   @map("bank_name")
  accountHolder String   @map("account_holder")
  accountLast4  String   @map("account_last4") @db.VarChar(4)
  accountEnc    String   @map("account_enc")
  ifsc          String   @db.VarChar(11)
  bankProofType String   @map("bank_proof_type")
  termsAcceptedAt DateTime @map("terms_accepted_at") @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

/// Uploaded file (encrypted). Uploaded before the form is submitted, then
/// attached to the new user; unattached uploads can be purged after 24 hours.
model Document {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String?      @map("user_id")
  kind            DocumentKind
  fileName        String       @map("file_name")
  mimeType        String       @map("mime_type")
  size            Int
  sha256          String
  data            Bytes // AES-256-GCM encrypted file bytes
  uploadTokenHash String       @map("upload_token_hash")
  ip              String?
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  attachedAt      DateTime?    @map("attached_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([attachedAt, createdAt])
  @@map("documents")
}

/// Sequence for readable IDs (DEO1001, VR201 …).
model IdCounter {
  key   String @id
  value Int

  @@map("id_counters")
}

enum AssignmentStatus {
  active
  completed
  cancelled
}

/// Work given to a Data Entry Operator for one PIN code area.
/// Rules (enforced in the API with row locks):
///  - a DEO can have only ONE active assignment at a time;
///  - a PIN code can have only ONE active assignment at a time.
/// The ID carries the PIN code, e.g. ASG-250401-001.
model Assignment {
  id           String           @id
  deoId        String           @map("deo_id")
  assignedById String           @map("assigned_by_id")
  taskType     String           @map("task_type")
  target       Int
  ratePerEntry Int              @map("rate_per_entry") // rupees per approved entry
  state        String
  district     String
  block        String
  village      String
  pincode      String           @db.VarChar(6)
  deadline     DateTime         @db.Date
  instructions String?
  status       AssignmentStatus @default(active)
  seenAt       DateTime?        @map("seen_at") @db.Timestamptz(6)
  completedAt  DateTime?        @map("completed_at") @db.Timestamptz(6)
  cancelledAt  DateTime?        @map("cancelled_at") @db.Timestamptz(6)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  deo        User    @relation("DeoAssignments", fields: [deoId], references: [id], onDelete: Cascade)
  assignedBy User    @relation("AdminAssignments", fields: [assignedById], references: [id])
  entries    Entry[]

  @@index([deoId, status])
  @@index([pincode, status])
  @@index([status, createdAt(sort: Desc)])
  @@map("assignments")
}

/// In-app notification (bell icon).
model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id")
  title     String
  body      String
  link      String?
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

enum EntryStatus {
  pending
  approved
  rejected
}

/// One school record entered by a DEO under an assignment.
/// State, educational district and PIN code come from the assignment.
model Entry {
  id                 String      @id // ENT000001 …
  assignmentId       String      @map("assignment_id")
  deoId              String      @map("deo_id")
  state              String
  district           String // educational district
  pincode            String      @db.VarChar(6)
  udiseCode          String      @unique @map("udise_code") @db.VarChar(11)
  schoolName         String      @map("school_name")
  educationalBlock   String      @map("educational_block")
  ruralUrban         String      @map("rural_urban") // Rural / Urban
  cluster            String
  lgdBlock           String      @map("lgd_block")
  lgdPanchayat       String      @map("lgd_panchayat")
  lgdVillage         String      @map("lgd_village")
  schoolCategory     String      @map("school_category")
  schoolManagement   String      @map("school_management")
  yearEstablished    Int         @map("year_established")
  yearRecognitionPri Int?        @map("year_recognition_pri")
  schoolType         String      @map("school_type")
  ratePerEntry       Int         @map("rate_per_entry") // copied from the assignment when submitted
  status             EntryStatus @default(pending)
  rejectReason       String?     @map("reject_reason")
  verifierId         String?     @map("verifier_id") // verifier this entry is assigned to (automatic)
  assignedAt         DateTime?   @map("assigned_at") @db.Timestamptz(6)
  verifiedById       String?     @map("verified_by_id")
  verifiedAt         DateTime?   @map("verified_at") @db.Timestamptz(6)
  resubmitCount      Int         @default(0) @map("resubmit_count")
  submittedAt        DateTime    @default(now()) @map("submitted_at") @db.Timestamptz(6)
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  deo        User       @relation("DeoEntries", fields: [deoId], references: [id], onDelete: Cascade)
  verifiedBy User?      @relation("VerifiedEntries", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifier   User?      @relation("AssignedEntries", fields: [verifierId], references: [id], onDelete: SetNull)

  verifications Verification[]

  @@index([verifierId, status])
  @@index([deoId, submittedAt(sort: Desc)])
  @@index([assignmentId, status])
  @@index([status, submittedAt])
  @@map("entries")
}

enum VerificationDecision {
  approved
  rejected
}

/// One approve / reject action by a verifier. Verifier income = sum of `rate`.
model Verification {
  id         String               @id @default(uuid()) @db.Uuid
  entryId    String               @map("entry_id")
  verifierId String               @map("verifier_id")
  deoId      String               @map("deo_id")
  decision   VerificationDecision
  reason     String?
  rate       Int // ₹ paid to the verifier for this action (from settings at that time)
  createdAt  DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  entry    Entry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  verifier User  @relation(fields: [verifierId], references: [id], onDelete: Cascade)

  @@index([verifierId, createdAt(sort: Desc)])
  @@index([entryId])
  @@map("verifications")
}

/// Portal settings (single row, id = 1), changed by the Super Admin.
model AppSetting {
  id             Int      @id @default(1)
  verifierRate   Int      @default(2) @map("verifier_rate") // ₹ per verified (approved or rejected) entry
  defaultDeoRate Int      @default(10) @map("default_deo_rate") // ₹ per approved entry, default for new work
  payoutWindow   String   @default("15th – 25th of every month") @map("payout_window")
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("app_settings")
}
